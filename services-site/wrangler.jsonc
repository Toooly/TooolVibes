{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tooolvibes-servizi",
  "main": "./src/worker.ts",
  "account_id": "ffacd11bfafdca87d540a6c5fbe89120",
  "compatibility_date": "2026-07-17",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "routes": [
    {
      "pattern": "servizi.tooolvibes.eu",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "SITE_URL": "https://servizi.tooolvibes.eu",
    "SITE_HOST": "servizi.tooolvibes.eu",
    "SERVICES_EMAIL_FROM": "TooolVibes Servizi <noreply@tooolvibes.eu>",
    "SERVICES_TURNSTILE_SITE_KEY": "0x4AAAAAAEiFbs9UcBewdZxB"
  },
  "secrets": {
    "required": [
      "RESEND_API_KEY",
      "SERVICES_NOTIFY_EMAIL",
      "TOOOLVIBES_TURNSTILE_SECRET_KEY"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
