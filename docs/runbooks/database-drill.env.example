# Copy to .env.db-drill only in an approved operator environment.
# Never commit the populated file and never source it in the application runtime.

TOOOLVIBES_DB_DRILL_CONFIRM=STAGING_ONLY
TOOOLVIBES_STAGING_PROJECT_REF=replace-with-staging-ref
TOOOLVIBES_RESTORE_PROJECT_REF=replace-with-disposable-restore-ref
TOOOLVIBES_PRODUCTION_PROJECT_REF=replace-with-production-ref

# Secrets stay empty in this template.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Prefer a local PGSERVICE/PGPASSFILE entry over a database URL in commands.
PGSERVICE=tooolvibes_restore_drill
PGPASSFILE=
