{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "tooolvibes",
  "compatibility_date": "2026-04-25",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://tooolvibes.eu",
    "NEXT_PUBLIC_AUTH_REDIRECT_ORIGIN": "https://tooolvibes.eu",
    "ALLOWED_AUTH_ORIGINS": "https://tooolvibes.eu",
    "NEXT_PUBLIC_SUPABASE_URL": "https://pjyasxaebxvvmcjxvnno.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_Ac8LC9KN9Yl9YjDC7KrCVA_9328FOc0",
    "TOOOLVIBES_EMAIL_FROM": "TooolVibes <noreply@tooolvibes.eu>",
    "TOOOLVIBES_COLLECTIONS_SOURCE": "mock",
    "TOOOLVIBES_TOOLS_SOURCE": "directory",
    "TOOOLVIBES_ARTICLE_CMS_STORAGE_FALLBACK": "1",
    "TOOOLVIBES_SECURITY_STATE_MODE": "service",
    "TOOOLVIBES_PUBLIC_GATE_ENABLED": "0",
    "TOOOLVIBES_ALLOW_MOCK_DATA": "1"
  },
  "services": [{ "binding": "SECURITY_STATE", "service": "tooolvibes-security-state" }],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
