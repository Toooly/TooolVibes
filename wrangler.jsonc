{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "tooolvibes",
  "account_id": "ffacd11bfafdca87d540a6c5fbe89120",
  "compatibility_date": "2026-04-25",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  "limits": {
    "cpu_ms": 300000
  },
  "build": {
    "command": "node scripts/patch-opennext-worker.mjs"
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://tooolvibes.eu",
    "NEXT_PUBLIC_AUTH_REDIRECT_ORIGIN": "https://tooolvibes.eu",
    "ALLOWED_AUTH_ORIGINS": "https://tooolvibes.eu",
    "NEXT_PUBLIC_SUPABASE_URL": "https://pjyasxaebxvvmcjxvnno.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_Ac8LC9KN9Yl9YjDC7KrCVA_9328FOc0",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAEiFbs9UcBewdZxB",
    "NEXT_PUBLIC_TINYADZ_ENABLED": "1",
    "NEXT_PUBLIC_TINYADZ_SITE_ID": "6a744c56118838f2f4456e99",
    "NEXT_PUBLIC_TINYADZ_TEST_MODE": "0",
    "TOOOLVIBES_EMAIL_FROM": "TooolVibes <noreply@tooolvibes.eu>",
    "TOOOLVIBES_COLLECTIONS_SOURCE": "content",
    "TOOOLVIBES_TOOLS_SOURCE": "directory",
    "TOOOLVIBES_ARTICLE_CMS_STORAGE_FALLBACK": "1",
    "TOOOLVIBES_SECURITY_STATE_MODE": "service",
    "TOOOLVIBES_PUBLIC_GATE_ENABLED": "0",
    "TOOOLVIBES_ALLOW_MOCK_DATA": "0",
    "TOOOLVIBES_WORKSPACE_SYNC_MODE": "canonical",
    "TOOOLVIBES_COMMUNITY_READ_ENABLED": "1",
    "TOOOLVIBES_COMMUNITY_WRITE_ENABLED": "0",
    "TOOOLVIBES_COMMUNITY_REPORT_ENABLED": "0"
  },
  "services": [{ "binding": "SECURITY_STATE", "service": "tooolvibes-security-state" }],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
