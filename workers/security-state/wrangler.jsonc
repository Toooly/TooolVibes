{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tooolvibes-security-state",
  "main": "index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "upload_source_maps": true,
  "limits": {
    "cpu_ms": 1000
  },
  "compatibility_date": "2026-04-25",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "SECURITY_STATE_DO",
        "class_name": "SecurityStateDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SecurityStateDurableObject"]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
