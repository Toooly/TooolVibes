# Core app URL
# In locale: http://localhost:3000
# In produzione su Netlify: https://YOUR-SITE.netlify.app oppure il dominio custom
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Obbligatorie se vuoi il datasource pubblico Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opzionale: source delle collection pubbliche
# auto = precedence supabase > content > mock
TOOOLVIBES_COLLECTIONS_SOURCE=auto

# Opzionale ma raccomandata se vuoi:
# - persistenza remota workspace guest/account
# - scritture admin reali
# - handoff guest -> account con sync remota
SUPABASE_SERVICE_ROLE_KEY=

# Opzionale: necessario solo se vuoi usare /admin in produzione
TOOOLVIBES_ADMIN_PASSWORD=imposta-una-password-temp
