# Core app URL
# In locale: http://localhost:3000
# In preview Cloudflare locale: http://127.0.0.1:8787
# In produzione Cloudflare: https://YOUR-WORKER.YOUR-SUBDOMAIN.workers.dev oppure il dominio custom
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Obbligatorie se vuoi il datasource pubblico Supabase
# Se usi Cloudflare Workers Builds, imposta queste variabili anche nella sezione Build Variables and secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opzionale: source delle collection pubbliche
# auto = precedence supabase > content > mock
TOOOLVIBES_COLLECTIONS_SOURCE=auto

# Opzionale: abilita la classifica "Migliori Toools su Product Hunt".
# Deve restare server-side: non usare prefisso NEXT_PUBLIC_.
# Puoi usare un developer token diretto oppure API Key + API Secret OAuth client-only.
PRODUCTHUNT_TOKEN=
PRODUCTHUNT_CLIENT_ID=
PRODUCTHUNT_CLIENT_SECRET=

# Opzionale ma raccomandata se vuoi:
# - persistenza remota workspace guest/account
# - scritture admin reali
# - handoff guest -> account con sync remota
# In Cloudflare trattala come secret, non come variabile in chiaro.
SUPABASE_SERVICE_ROLE_KEY=

# Abilita il CMS articoli su Supabase Storage quando la tabella editorial_articles
# non e ancora presente. Il codice usa un indice JSON unico per evitare troppi
# subrequest su Cloudflare Workers.
TOOOLVIBES_ARTICLE_CMS_STORAGE_FALLBACK=1

# ============================
# ADMIN AUTH
# ============================

# Email dell'account amministratore (server-side only)
# In Cloudflare trattala come variabile environment.
TOOOLVIBES_ADMIN_EMAIL=

# Password admin come hash bcrypt (consigliato, server-side only)
# Per generare l'hash: npx tsx scripts/generate-admin-hash.ts
# Esempio placeholder (NON usare in produzione).
# Nei file .env usati da Next.js, ogni $ dell'hash bcrypt va escapato come \$.
# TOOOLVIBES_ADMIN_PASSWORD_HASH=\$2a\$10\$...
TOOOLVIBES_ADMIN_PASSWORD_HASH=

# Password admin in chiaro (legacy, server-side only)
# Se TOOOLVIBES_ADMIN_PASSWORD_HASH è impostato, questo viene ignorato.
# Meno sicuro dell'hash bcrypt. In Cloudflare trattala come secret.
TOOOLVIBES_ADMIN_PASSWORD=imposta-una-password-temp

# Opzionale: segreto per firmare i cookie di sessione admin.
# Se non impostato, viene derivato dalla password/hash password.
# In Cloudflare trattala come secret.
TOOOLVIBES_SESSION_SECRET=

# =====================================================
# ⚠️ CRITICAL WARNING FOR CLOUDFLARE GIT DEPLOYS
# =====================================================
# If you use Git-connected Workers Builds (recommended),
# you MUST also add the admin secrets in the Cloudflare
# dashboard under:
#   Workers & Pages → tooolvibes → Builds → Build configuration
#   → Build variables and secrets
#
# Otherwise every new `git push` or `npm run deploy` will
# cause the admin login to stop working (secrets disappear
# from the new build).
#
# See README.md → "Collega il repo a Cloudflare" section.

# Opzionale: abilita log server-side sicuri per il flusso admin login/logout.
# Non stampa mai la password.
TOOOLVIBES_AUTH_DEBUG=

# ============================
# EMAIL / RESEND
# ============================

# Opzionale: abilita email transazionali per suggerimenti tool e affiliati.
# Se assente, le operazioni restano salvate in Supabase ma le email non partono.
RESEND_API_KEY=
TOOOLVIBES_EMAIL_FROM="TooolVibes <noreply@tooolvibes.com>"
TOOOLVIBES_ADMIN_NOTIFY_EMAIL=
