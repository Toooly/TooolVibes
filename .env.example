# Core app URL
# In locale: http://localhost:3000
# In preview Cloudflare locale: http://127.0.0.1:8787
# In produzione Cloudflare: https://YOUR-WORKER.YOUR-SUBDOMAIN.workers.dev oppure il dominio custom
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL pubblico usato solo dai link email Supabase.
# Impostalo in produzione/preview per evitare redirect verso localhost.
NEXT_PUBLIC_AUTH_REDIRECT_ORIGIN=https://tooolvibes.eu
ALLOWED_AUTH_ORIGINS=https://tooolvibes.eu

# Obbligatorie se vuoi il datasource pubblico Supabase
# Se usi Cloudflare Workers Builds, imposta queste variabili anche nella sezione Build Variables and secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Source canonica dei tool pubblici (obbligatoria in produzione).
# directory = catalogo statico attuale; supabase = CMS; mock = fixture esplicita.
# Mantieni directory finché DATA-203 non certifica import e parità CMS in staging.
TOOOLVIBES_TOOLS_SOURCE=directory

# Fallback consentito solo fuori produzione. "none" non maschera empty/error.
TOOOLVIBES_TOOLS_FALLBACK=none

# Shadow read opzionale: confronta solo metriche aggregate, non cambia l'output.
TOOOLVIBES_TOOLS_COMPARE_SOURCE=none

# Il mock richiede sia source/fallback=mock sia questa abilitazione esplicita.
TOOOLVIBES_ALLOW_MOCK_DATA=0
# Opzionale: source delle collection pubbliche
# auto = precedence supabase > content > mock
TOOOLVIBES_COLLECTIONS_SOURCE=auto

# Opzionale: abilita la classifica "Migliori Toools su Product Hunt".
# Deve restare server-side: non usare prefisso NEXT_PUBLIC_.
# Puoi usare un developer token diretto oppure API Key + API Secret OAuth client-only.
PRODUCTHUNT_TOKEN=
PRODUCTHUNT_CLIENT_ID=
PRODUCTHUNT_CLIENT_SECRET=

# Opzionale ma raccomandata se vuoi:
# - persistenza remota workspace guest/account
# - scritture admin reali
# - handoff guest -> account con sync remota
# In Cloudflare trattala come secret, non come variabile in chiaro.
SUPABASE_SERVICE_ROLE_KEY=

# Abilita la workspace remota canonica solo dopo aver applicato e verificato
# la migration DATA-206 (workspace_state v1 + CAS) nell'ambiente target.
# MVP 1.0 production: canonical. Unset/empty keeps local-only fail-safe.
# Enable only after DATA-206 (workspace_state v1 + CAS) is applied.
TOOOLVIBES_WORKSPACE_SYNC_MODE=canonical

# Abilita il CMS articoli su Supabase Storage quando la tabella editorial_articles
# non e ancora presente. Il codice usa un indice JSON unico per evitare troppi
# subrequest su Cloudflare Workers.
TOOOLVIBES_ARTICLE_CMS_STORAGE_FALLBACK=1

# ============================
# ADMIN AUTH
# ============================

# Email dell'account amministratore (server-side only)
# In Cloudflare trattala come variabile environment.
TOOOLVIBES_ADMIN_EMAIL=

# Password admin come hash bcrypt obbligatorio (server-side only)
# Per generare l'hash: npx tsx scripts/generate-admin-hash.ts
# Esempio placeholder (NON usare in produzione).
# Nei file .env usati da Next.js, ogni $ dell'hash bcrypt va escapato come \$.
# TOOOLVIBES_ADMIN_PASSWORD_HASH=\$2a\$10\$...
TOOOLVIBES_ADMIN_PASSWORD_HASH=

# Se TOOOLVIBES_ADMIN_PASSWORD_HASH è impostato, questo viene ignorato.
# Meno sicuro dell'hash bcrypt. In Cloudflare trattala come secret.

# Segreto obbligatorio e indipendente per firmare i cookie di sessione admin.
# In Cloudflare trattala come secret.
TOOOLVIBES_SESSION_SECRET=

# =====================================================
# ⚠️ CRITICAL WARNING FOR CLOUDFLARE GIT DEPLOYS
# =====================================================
# If you use Git-connected Workers Builds (recommended),
# you MUST also add the admin secrets in the Cloudflare
# dashboard under:
#   Workers & Pages → tooolvibes → Builds → Build configuration
#   → Build variables and secrets
#
# Otherwise every new `git push` or `npm run deploy` will
# cause the admin login to stop working (secrets disappear
# from the new build).
#
# See README.md → "Collega il repo a Cloudflare" section.

# Opzionale: abilita log server-side sicuri per il flusso admin login/logout.
# Non stampa mai la password.
TOOOLVIBES_AUTH_DEBUG=

# ============================
# EMAIL / RESEND
# ============================

# Opzionale: abilita email transazionali per suggerimenti tool e affiliati.
# Se assente, le operazioni restano salvate in Supabase ma le email non partono.
RESEND_API_KEY=
TOOOLVIBES_EMAIL_FROM="TooolVibes <noreply@tooolvibes.eu>"
TOOOLVIBES_ADMIN_NOTIFY_EMAIL=

# ============================
# DISTRIBUTED SECURITY STATE
# ============================
# In produzione deve essere "service" e richiede il binding Cloudflare
# SECURITY_STATE verso il worker tooolvibes-security-state.
# "memory" e consentito solo in sviluppo locale e fixture E2E; "deny" blocca
# tutte le operazioni protette come kill switch fail-closed.
TOOOLVIBES_SECURITY_STATE_MODE=memory

# Segreto HMAC server-side di almeno 32 caratteri. Non viene inviato al worker
# di stato e impedisce che IP, email o token compaiano nelle chiavi persistite.
TOOOLVIBES_SECURITY_STATE_KEY_SECRET=

# ============================
# PUBLIC SUBMISSION PROTECTION
# ============================
# Cloudflare Turnstile e obbligatorio in produzione per waitlist, suggerimenti
# tool e candidature affiliate. La site key e pubblica e deve essere presente
# anche nelle build variables; la secret key resta esclusivamente server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TOOOLVIBES_TURNSTILE_SECRET_KEY=

# ============================
# BROWSER SECURITY
# ============================
# HSTS e attivo per default solo su HTTPS in produzione.
# Imposta "false" esclusivamente come kill switch temporaneo.
TOOOLVIBES_SECURITY_HSTS=


# ============================
# COMING SOON GATE
# ============================
# Kill switch server-side per le iscrizioni waitlist.
# Default: abilitato. Imposta 0 per disabilitare immediatamente la route.
# Richiede NEXT_PUBLIC_SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY.
TOOOLVIBES_WAITLIST_ENABLED=1


# Password per accedere al sito completo tramite il varco interno.
# Deve restare server-side: non usare prefisso NEXT_PUBLIC_.
# In Cloudflare trattala come secret (Build variables and secrets).
TOOOLVIBES_GATE_PASSWORD=

# ============================
# SIGNAL PROGRESSION / REWARDS (default OFF)
# ============================
# TOOOLVIBES_GAMIFICATION_ENABLED=0
# TOOOLVIBES_GAMIFICATION_PERSISTENCE_ENABLED=0
# TOOOLVIBES_REWARD_BACKBONE_ENABLED=0
# TOOOLVIBES_REWARD_RUNTIME_ENABLED=0
# TOOOLVIBES_SIGNAL_EVENT_WRITES_ENABLED=0
# TOOOLVIBES_REWARD_DELIVERY_ENABLED=0
# TOOOLVIBES_SIGNAL_PROGRESS_UI_ENABLED=0
# Phase 6: server-owned achievements, badge cabinet, major milestone presentations.
# TOOOLVIBES_SIGNAL_ACHIEVEMENTS_ENABLED=0
# TOOOLVIBES_SIGNAL_BADGE_CABINET_ENABLED=0
# TOOOLVIBES_REWARD_MILESTONES_ENABLED=0


# ============================
# TINYADZ PUBLISHER (default OFF)
# ============================
# TinyAdz is a third-party advertising script. The integration is consent- and
# feature-flag gated and ships DISABLED. Advertising consent is provided by the
# first-party AdvertisingConsentProvider (banner + "Gestisci preferenze" in the
# footer): TinyAdz only loads when consent is explicitly GRANTED and the route
# is eligible (see components/ads/, lib/ads/advertising-consent.ts).
#
# Do NOT enable (set to true) unless a real advertising-consent grant exists.
# Production must stay disabled (or the variable absent) until dashboard
# placement is reviewed (the CORNER popup currently overlaps mobile UI).
#
# NEXT_PUBLIC_TINYADZ_ENABLED=0
# Site id from the TinyAdz owner dashboard (public, not a secret).
# NEXT_PUBLIC_TINYADZ_SITE_ID=
# Test mode MUST be true in local/preview. Set false in production only after
# test-mode QA succeeds. Safe default is true.
# NEXT_PUBLIC_TINYADZ_TEST_MODE=true

# TOOOLVIBES_COMMUNITY_READ_ENABLED=0
